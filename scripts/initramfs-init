#!/bin/sh
# RetroStick initramfs /init
#
# Replaces Alpine's default init. Finds the RETROROOT SquashFS partition
# by filesystem type (blkid -t TYPE=squashfs) rather than by label or UUID,
# since SquashFS has no filesystem label or UUID support.
#
# machine= is read from the kernel cmdline by retroarch-launch.start after
# switch_root — we just pass the cmdline through unchanged.

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true

# Load filesystem and storage modules
for mod in squashfs sd_mod usb_storage uas ahci libahci \
           xhci_hcd xhci_pci ehci_hcd uhci_hcd ohci_hcd \
           nvme virtio_blk; do
    modprobe "$mod" 2>/dev/null || true
done

# Populate /dev via mdev
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
/sbin/mdev -s

# Wait for the SquashFS partition to appear (USB needs time to enumerate)
RETRO_DEV=""
i=0
while [ "$i" -lt 15 ]; do
    RETRO_DEV=$(blkid -t TYPE=squashfs -o device 2>/dev/null | head -1)
    [ -n "$RETRO_DEV" ] && break
    i=$((i + 1))
    sleep 1
done

if [ -z "$RETRO_DEV" ]; then
    echo "RetroStick: ERROR — RETROROOT (squashfs) partition not found"
    echo "Available devices:"
    blkid 2>/dev/null || true
    exec /bin/sh
fi

echo "RetroStick: mounting $RETRO_DEV as RETROROOT"
mkdir -p /sysroot
if ! mount -t squashfs -o ro "$RETRO_DEV" /sysroot; then
    echo "RetroStick: ERROR — cannot mount $RETRO_DEV as squashfs"
    exec /bin/sh
fi

# Move virtual filesystems into new root before switch
mount --move /dev  /sysroot/dev  2>/dev/null || true
mount --move /proc /sysroot/proc 2>/dev/null || true
mount --move /sys  /sysroot/sys  2>/dev/null || true

exec switch_root /sysroot /sbin/init
